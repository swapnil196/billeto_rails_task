#!/usr/bin/env bash
set -e

# Vote counts are maintained by a background handler, so the app needs a worker
# as well as a web server. Starting only `rails server` makes voting look
# broken: the vote is recorded and the fact is published, but nothing drains
# the queue, so the count never moves.
if ! gem list foreman --installed --silent; then
  echo "Installing foreman..."
  gem install foreman
fi

exec foreman start -f Procfile.dev "$@"
