<div class="session">
  <% if dev_sign_in? %>
    <%# Test environment only: Clerk's hosted screens cannot be driven from a
        spec without shipping a secret key into CI. %>
    <% if signed_in? %>
      <span class="session__who">Signed in as <code><%= current_user_id %></code></span>
      <%= button_to "Sign out", dev_session_path, method: :delete, class: "btn btn--quiet" %>
    <% else %>
      <%= form_with url: dev_session_path, method: :post, class: "session__form" do |form| %>
        <%= form.label :user_id, "Sign in as", class: "session__label" %>
        <%= form.text_field :user_id, value: "user_demo", class: "session__input" %>
        <%= form.submit "Sign in", class: "btn" %>
      <% end %>
    <% end %>
  <% elsif clerk_configured? %>
    <% if signed_in? %>
      <span class="session__who">Signed in as <code><%= current_user_id %></code></span>
      <div data-clerk-mount="user-button"></div>
    <% else %>
      <%= link_to "Sign in", sign_in_path, class: "btn" %>
      <%= link_to "Create account", sign_up_path, class: "btn btn--quiet" %>
    <% end %>
  <% else %>
    <span class="session__who muted">Clerk is not configured &mdash; voting is unavailable.</span>
  <% end %>
</div>
